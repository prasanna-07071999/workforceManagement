############################################
# 👥 Employee Management
############################################

### Get all employees
GET {{BASE_URL}}/api/employees
Authorization: Bearer {{ADMIN_TOKEN}}

###

### Get employee by ID
GET {{BASE_URL}}/api/employees/694e7349fc3751834d3b4d9f
Authorization: Bearer {{ADMIN_TOKEN}}

###

### Create employee (with temp password)
POST {{BASE_URL}}/api/employees
Authorization: Bearer {{ADMIN_TOKEN}}
Content-Type: application/json

{
  "firstName": "RamaKrishna",
  "lastName": "Reddy",
  "email": "ramakrishna@basant.com",
  "phone": "7894785960",
  "password": "123456789"
}

###

### Update employee
PUT {{BASE_URL}}/api/employees/6960676747f4a3c1a2574d8f
Authorization: Bearer {{ADMIN_TOKEN}}
Content-Type: application/json

{
  "phone": "7418529630"
}

###

### Delete employee
DELETE {{BASE_URL}}/api/employees/695f9545b41217cffc6dbb96
Authorization: Bearer {{ADMIN_TOKEN}}

############################################
# 👥 Team Management
############################################

### Get all teams
GET {{BASE_URL}}/api/teams
Authorization: Bearer {{ADMIN_TOKEN}}

###

### Get team by ID
GET {{BASE_URL}}/api/teams/695f94b7b41217cffc6dbb74
Authorization: Bearer {{ADMIN_TOKEN}}

###

### Create team
POST {{BASE_URL}}/api/teams
Authorization: Bearer {{ADMIN_TOKEN}}
Content-Type: application/json

{
  "name": "Medical Department",
  "description": "Need to check all employees health related issues and suggest precautions"
}

###

### Update team
PUT {{BASE_URL}}/api/teams/696068a847f4a3c1a2574dc4
Authorization: Bearer {{ADMIN_TOKEN}}
Content-Type: application/json

{
  "description": "Need to check all employees health related issues and suggest precautions based on their health status."
}

###

### Delete team
DELETE {{BASE_URL}}/api/teams/6960684747f4a3c1a2574dbb
Authorization: Bearer {{ADMIN_TOKEN}}

